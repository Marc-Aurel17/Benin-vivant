# Copie ce fichier en ".env" (sans ".example") dans ce même dossier, puis
# remplis les valeurs. Le fichier .env ne doit JAMAIS être partagé/commité.

# --- Base de données (mêmes identifiants que backend-php/config/database.php) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=benin_vivant
DB_USER=root
DB_PASSWORD=

# --- Sécurité interne (doit être IDENTIQUE à AI_SERVICE_API_KEY dans backend-php/config/config.php) ---
AI_SERVICE_API_KEY=change-moi-avec-une-cle-aleatoire-longue

# --- Anthropic (Claude) — récupère ta clé sur https://console.anthropic.com ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
